task: evaluation
run_id: complete-char
provider: openai
model: gpt-5.5
evaluations_dir: data/evaluations

aws_region: us-west-2
dynamodb_endpoint_url: http://localhost:8000
outcomes_table: outcomes
articles_table: articles

# Subset controls.
# Start at this CSR ID in CSR index order.
starting_review: CSR_0279
# Evaluate at most this many outcome questions after applying starting_review.
max_questions: 1
# Optionally uncomment to limit the number of CSR IDs considered.
# review_count: 10

# Complete study characteristics/results in a single-turn context.
detail_exposure_types:
  - complete_char
irrelevant_docs_per_context: 0
max_contexts_per_outcome: 10
